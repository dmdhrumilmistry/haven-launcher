    <!-- Prompts -->
    <string name="lock_setup_title">Double-tap to lock</string>
    <string name="lock_setup_body">Android only lets a home screen lock the phone through an accessibility service.\n\nHaven\'s service does exactly one thing: lock the screen when you double-tap (and open notifications if you swipe down). It can\'t see your screen, doesn\'t collect anything and Haven has no internet access.\n\nIn the next screen, open \"Haven - screen lock gesture\" and turn it on.</string>
    <string name="need_default_title">Make Haven your home app</string>
    <string name="need_default_body">Android only allows your current home app to pause work apps or lock your private space.</string>

