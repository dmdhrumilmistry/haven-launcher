<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Haven deliberately has NO internet permission. No ads, no analytics, no network.
    -->

    <!-- Swipe down to open the notification shade. Normal permission, granted at install. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- Fingerprint/face prompt for locked hidden apps. Normal permission, granted at install. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Lets the "Uninstall" action open the system uninstall dialog. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Android 15+: lets the default home app see the private space so it can show a lock/unlock entry. -->
    <uses-permission
        android:name="android.permission.ACCESS_HIDDEN_PROFILES"
        tools:ignore="ProtectedPermissions" />

    <!-- Package visibility (Android 11+): launchable apps plus the intents we offer as shortcuts. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.WEB_SEARCH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MESSAGING" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_BROWSER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <!-- Icon packs (ADW / Nova / Apex formats). -->
        <intent>
            <action android:name="org.adw.launcher.THEMES" />
        </intent>
        <intent>
            <action android:name="com.novalauncher.THEME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.anddoes.launcher.THEME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.teslacoilsw.launcher.THEME" />
        </intent>
        <!-- Digital Wellbeing's app timer screen. -->
        <intent>
            <action android:name="android.settings.action.APP_USAGE_SETTINGS" />
        </intent>
        <!-- Phone makers' own app-cloning screens, for "Clone app". -->
        <intent>
            <action android:name="android.settings.MANAGE_CLONED_APPS_SETTINGS" />
        </intent>
        <package android:name="com.android.settings" />
        <package android:name="com.samsung.android.da.daagent" />
        <package android:name="com.miui.securitycore" />
        <package android:name="com.motorola.settings" />
        <!-- Apps that only offer widgets (no launcher icon) must still show up in the widget picker. -->
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" android:host="com.android.calendar" />
        </intent>
    </queries>

    <application
        android:name=".HavenApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Haven">

        <!-- The home screen itself. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:resumeWhilePausing="true"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale"
            android:theme="@style/Theme.Haven.Home">
            <intent-filter android:priority="1">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Settings are reachable from any launcher, so people can set Haven up before switching. -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="true"
            android:label="@string/settings_launcher_label"
            android:taskAffinity="app.haven.launcher.settings"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Apps (e.g. a browser's "Add to home screen") ask the default launcher to pin shortcuts here. -->
        <activity
            android:name=".AddShortcutActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Haven.Dialog">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
                <action android:name="android.content.pm.action.CONFIRM_PIN_APPWIDGET" />
            </intent-filter>
        </activity>
    </application>
</manifest>
